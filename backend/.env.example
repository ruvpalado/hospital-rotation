# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_rotation_db
DB_USER=root
DB_PASSWORD=changeme
# Set to true for managed hosts (Railway, PlanetScale, etc.) that require SSL
DB_SSL=false

# JWT -- MUST be a long random string in any real deployment (the app warns
# at boot if this is missing or left as the placeholder below).
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Developer account default password (used only when the account is first
# created). Override here so it isn't the value hardcoded in source.
DEVELOPER_PASSWORD=

# Seeding: `npm run seed` only wipes + reseeds an EMPTY database. To force a
# full wipe + reseed of a database that already has data, set SEED_FORCE=true.
# (Leave unset so a pre-deploy seed can never destroy real data.)
SEED_FORCE=

# Production only: the deployed frontend origin, so CORS isn't wide open.
# Example: https://your-app.vercel.app
FRONTEND_URL=

# Notifications - leave blank to run in MOCK mode (logs to console + DB only)
NOTIFY_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Rotation completion rule
MIN_WEEKS_FOR_COMPLETION=3
BLOCK_TOTAL_WEEKS=4
