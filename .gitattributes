# Normalize line endings: store text files as LF in the repo and check them
# out as LF on every platform. Ends the CRLF/LF churn that otherwise shows
# up as spurious "modified" files when the repo is edited across Windows and
# Linux tooling. Binary assets are marked so git never touches them.
* text=auto eol=lf

# Explicit text types (safety, in case auto-detection is unsure)
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.env  text eol=lf

# Binary assets -- never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
